# Copie para .env. Nunca publique credenciais.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# demo usa apenas dados fictícios e é bloqueado em produção.
APP_MODE=demo
DATABASE_PATH=./data/godeye.sqlite
# Gere dois valores diferentes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DATA_ENCRYPTION_KEY=
# Modo microsoft: registro de aplicativo web multitenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# UUIDs separados por vírgula; vazio recusa TODOS os tenants no modo microsoft.
ALLOWED_TENANT_IDS=
# Escrita exige também consentimento GroupMember.ReadWrite.All e papel GodEye.Approver.
ENABLE_WRITES=false
# Opcional: sem chave, consultas e proposta estruturada funcionam pela interface.
OPENAI_API_KEY=
# Preencha com um modelo disponível no seu projeto que suporte Responses/function calling.
OPENAI_MODEL=
